  if (version !== generation) return;
  account = next;
  times.account = Date.now();
  delete errors.account;
  // Restore the previous sample only after confirming the logged-in UID.
  if (features.followers && !followers) {
    try {
      const saved = JSON.parse(localStorage.getItem("followers:v1:" + next.uid) || "null");
      if (saved && count(saved.count) && metric(saved.at)) {
        followers = { ...saved, following: null };
        times.followers = saved.at;
