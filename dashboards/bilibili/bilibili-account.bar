    login.svg ? h("Image", { key: "login-qr", svg: login.svg, width: qrSize, height: qrSize,
      radius: 12, background: "#ffffff", border: [1, "border"], textColor: "#000000", label: "哔哩哔哩登录二维码",
      ...(motionAllowed() ? { keyframes: { ...LOGIN_REVEAL, run: loginVersion } } : {}) }) : null,
    h("Row", { gap: 8, width: "100%", alignItems: "center", justify: "center" },
      busy ? h("Loading", { key: "login-loading", size: 16, color: "textMuted", label: "登录处理中", shrink: 0 }) : null,
      text(message, { key: "login-status", fontSize: 13, lineHeight: 1.375, minWidth: 0, shrink: 1,
        wrap: true, textAlign: "center", textColor: retry || problem ? "warning" : busy ? "textMuted" : "text" })),
    h("Row", { gap: 8, width: "100%", justify: "center" },
      login.phase !== "idle" ? h("ButtonBase", { key: "login-cancel", height: 32, paddingX: 14, paddingY: 0,
        radius: 16, background: "surface", disabled: login.phase === "saving",
        onClick: () => cancelLogin(), label: account ? "返回账户" : "取消", focusRing: true,
        hover: { background: "surfaceHover" }, ...pressStyle() },
        text(account ? "返回账户" : "取消", { fontSize: 13, textColor: "textMuted" })) : null,
      h("ButtonBase", { key: active ? "login-regenerate" : "login-start", height: 32, paddingX: 14, paddingY: 0,
        ...(active ? {} : { grow: 1, basis: 0 }), radius: 16, background: active ? "surface" : "text", disabled: busy,
        onClick: () => startLogin(), label: action, focusRing: true,
        hover: active ? { background: "surfaceHover" } : { opacity: 0.88 }, ...pressStyle() },
        text(action, { fontSize: 13, fontWeight: active ? 400 : 500, textColor: active ? "textMuted" : "surface" }))),
    problem && times.account ? note("上次成功：" + stamp(times.account)) : null);
}
function panel(env) {
  const now = Date.now(), connected = account && login.phase === "idle" && !inputError;
  const width = Math.max(200, Math.min(320, env.viewport?.width || 320)) - 32;
  const compactAccount = tabs.length === 1 && tabs[0].id === "account" && !features.followers;
  const connectedHeight = compactAccount ? (features.level ? 280 : 208) : 400;
  const contextMenu = [{ label: "重新扫码登录", onClick: () => startLogin() },
    { label: "打开个人空间", disabled: !account, onClick: launch(account ? "https://space.bilibili.com/" + account.uid : "https://www.bilibili.com/") }];
  const identity = account ? `${account.uid}:${account.level}:${account.xp}` : "";
