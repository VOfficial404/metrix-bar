const API = "https://api.bilibili.com";
const MEMBER = "https://member.bilibili.com";
const IM = "https://api.vc.bilibili.com";
const PASSPORT = "https://passport.bilibili.com";
// Official Bilibili header level SVG fills, verified 2026-11-09.
const LEVEL_COLORS = ["#C0C0C0", "#C0C0C0", "#8BD29B", "#7BCDEF", "#FEBB8B", "#EE672A", "#FF0000"];
const MARK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7 2 3 4m7-4-3 4"/><rect x="3" y="6" width="18" height="15" rx="4"/><path d="M8 11v3m8-3v3m-7 3h6"/></svg>';
const h = (type, props = {}, ...children) => ({ type, props, children: children.flat().filter(v => v != null && v !== false) });
const text = (value, props = {}) => h("Text", { text: String(value), ...props });
const count = value => Number.isSafeInteger(value) && value >= 0;
