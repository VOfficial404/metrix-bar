    return { tray: { icon: "data:image/svg+xml," + encodeURIComponent(MARK), iconTemplate: true, title,
      tooltip: account ? account.name + (features.identity ? " · UID " + account.uid : "") : "连接自己的 B 站账户",
      error: inputError || Object.values(errors).join("；"),
      menu: [{ label: "刷新", disabled: loading || !!inputError, onClick: () => requestRefresh() },
        { label: "扫码登录", onClick: () => startLogin() },
        privateEnabled() ? { label: "打开私信", onClick: launch("https://message.bilibili.com/#/whisper") } : null].filter(Boolean) }, panel: panel(env) };
  },
  async event(name, payload) {
    if (name === "login") {
      await startLogin();
      await $metrix.panel.open();
