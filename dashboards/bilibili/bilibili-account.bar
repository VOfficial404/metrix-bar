}
function readVideo(data, uid) {
  if (!data.owner || !count(data.owner.mid)) invalid();
  if (data.owner.mid !== uid) return null;
  if (!/^BV[0-9A-Za-z]+$/.test(data.bvid || "") || typeof data.title !== "string" || !count(data.pubdate)) invalid();
  const stat = data.stat;
  if (VIDEO_STATS.some(({ option, api }) => features[option] && !count(stat?.[api]))) invalid();
  return { id: data.bvid, title: data.title, cover: features.video_cover ? imageURL(data.pic) : "", published: data.pubdate * 1000,
    views: stat?.view, likes: stat?.like, favorites: stat?.favorite, coins: stat?.coin, replies: stat?.reply };
}
async function loadVideos(uid, session, signal, limit) {
  const selected = [], seen = new Set();
  // Authenticated published uploads avoid the public-space discovery endpoint's HTTP 412.
  for (let page = 1; selected.length < limit; page++) {
    const query = new URLSearchParams({ status: "pubed", pn: String(page), ps: "30", coop: "1", interactive: "1" });
    const data = await get(MEMBER, "/x/web/archives?" + query, session, signal);
    if (!Array.isArray(data.arc_audits) || !data.page || !count(data.page.count)
        || !count(data.page.ps) || data.page.ps === 0 || data.page.pn !== page) invalid();
    if (!data.arc_audits.length) {
      if ((page - 1) * data.page.ps < data.page.count) invalid();
      break;
    }
    const archives = data.arc_audits.map(item => item.Archive);
    for (const item of archives) {
      if (!item || !/^BV[0-9A-Za-z]+$/.test(item.bvid || "") || !count(item.ptime) || !Number.isInteger(item.state)) invalid();
    }
    const ordered = archives.filter(item => item.state === 0).sort((a, b) => b.ptime - a.ptime);
    const candidates = ordered.filter(item => !seen.has(item.bvid));
    // Bounded concurrency respects the native Worker's four-fetch limit.
    for (let i = 0; i < candidates.length && selected.length < limit;) {
      const batch = candidates.slice(i, i + Math.min(3, limit - selected.length));
      i += batch.length;
      const details = await Promise.all(batch.map(item => {
        seen.add(item.bvid);
        return get(API, "/x/web-interface/view?bvid=" + encodeURIComponent(item.bvid), session, signal);
      }));
      for (const detail of details) {
        const video = readVideo(detail, uid);
        if (video) selected.push(video);
      }
    }
    if (page * data.page.ps >= data.page.count) break;
  }
  return selected.sort((a, b) => b.published - a.published).slice(0, limit);
}
function sampleVideos(uid, rows) {
  const key = "videos:v1:" + uid, now = Date.now(), samples = {};
  let previous = null;
  try { previous = JSON.parse(localStorage.getItem(key) || "null"); } catch {}
  const result = rows.map(video => {
    const prior = previous?.[video.id];
    const usable = prior && metric(prior.at) && prior.at <= now;
    const sample = { at: now }, delta = {};
    for (const { field } of VIDEO_STATS) {
      if (count(video[field])) {
        sample[field] = video[field];
        delta[field] = usable && count(prior[field]) ? video[field] - prior[field] : null;
      } else delta[field] = null;
    }
    samples[video.id] = sample;
    return { ...video, delta, since: usable ? prior.at : null };
  });
  localStorage.setItem(key, JSON.stringify(samples));
  return result;
}
async function load(session, limit, version, signal) {
