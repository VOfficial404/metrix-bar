        h("Icon", { svg: MARK, width: 22, height: 22, fontSize: 22, textColor: "accent" })),
      h("Column", { gap: 0, grow: 1, minWidth: 0 },
        text("哔哩哔哩", { fontSize: 16, fontWeight: 500 }), note(account ? "切换账户" : "账户登录"))),
    connected && tabs.length > 1 ? Navigation(width, now) : null,
    connected ? sectionError("account") : null,
