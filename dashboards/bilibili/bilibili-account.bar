<bar protocol-version="0" id="bilibili-account" title="哔哩哔哩账户"
     version="1.7.1" category="social" icon="tv"
     description="查看 B 站账户、视频统计变化和私信会话；整体每 6 小时刷新，私信默认每 10 分钟刷新。"
     license="AGPL-3.0-only" homepage="https://github.com/VOfficial404/metrix-bar"
     refresh="6h" material="solid">
  <permissions>
    <network origin="https://api.bilibili.com" />
    <network origin="https://member.bilibili.com" />
    <network origin="https://api.vc.bilibili.com" />
    <network origin="https://passport.bilibili.com" />
    <network origin="https://i0.hdslb.com" />
    <network origin="https://i1.hdslb.com" />
    <network origin="https://i2.hdslb.com" />
  </permissions>
  <inputs>
    <input name="show_identity" type="bool" label="账户 · UID 与硬币" default="true" />
    <input name="show_followers" type="bool" label="账户 · 粉丝与关注" default="true" />
    <input name="show_level" type="bool" label="账户 · 等级与经验" default="true" />
    <input name="show_videos" type="bool" label="视频 · 启用视频页" default="true" />
    <input name="video_count" type="select" label="视频 · 最近投稿数量" default="5">
      <option value="3" label="3 条" />
      <option value="5" label="5 条" />
      <option value="10" label="10 条" />
    </input>
    <input name="show_video_cover" type="bool" label="视频 · 封面" default="true" />
    <input name="show_video_date" type="bool" label="视频 · 发布时间" default="true" />
    <input name="show_video_views" type="bool" label="视频 · 播放量" default="true" />
    <input name="show_video_likes" type="bool" label="视频 · 点赞数" default="true" />
    <input name="show_video_favorites" type="bool" label="视频 · 收藏数" default="true" />
    <input name="show_video_coins" type="bool" label="视频 · 投币数" default="true" />
    <input name="show_video_comments" type="bool" label="视频 · 评论数" default="true" />
    <input name="show_messages" type="bool" label="消息 · 启用消息页" default="true" />
    <input name="show_message_private" type="bool" label="消息 · 未读私信" default="true" />
    <input name="private_display" type="select" label="消息 · 私信展示方式" default="summary">
      <option value="summary" label="统计卡片" />
      <option value="list" label="会话列表" />
    </input>
    <input name="private_count" type="select" label="消息 · 最近会话数量" default="5">
      <option value="3" label="3 条" />
      <option value="5" label="5 条" />
      <option value="10" label="10 条" />
    </input>
    <input name="private_card_size" type="select" label="消息 · 会话卡片尺寸" default="normal">
      <option value="compact" label="紧凑" />
      <option value="normal" label="正常" />
    </input>
    <input name="private_refresh" type="select" label="消息 · 私信刷新频率" default="10m">
      <option value="5m" label="5 分钟" />
      <option value="10m" label="10 分钟" />
      <option value="30m" label="30 分钟" />
      <option value="1h" label="1 小时" />
      <option value="6h" label="6 小时" />
    </input>
    <input name="show_message_likes" type="bool" label="消息 · 收到的赞" default="true" />
    <input name="show_message_replies" type="bool" label="消息 · 回复我的" default="true" />
    <input name="show_message_mentions" type="bool" label="消息 · @ 我的" default="true" />
    <input name="show_message_system" type="bool" label="消息 · 系统通知" default="true" />
    <input name="show_message_assistant" type="bool" label="消息 · UP 主助手" default="true" />
    <input name="sessdata" type="secret" label="高级 · SESSDATA（可选）"
           help="默认使用看板内扫码登录。" />
  </inputs>
  <docs><![CDATA[打开看板扫码登录，在设置中选择需要的功能。详细说明：https://github.com/VOfficial404/metrix-bar/tree/main/dashboards/bilibili#readme]]></docs>
