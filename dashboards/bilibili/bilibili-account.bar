    connected ? note("整体每 6 小时" + (privateEnabled() ? " · 私信每 " + PRIVATE_RATES[privateRate].label : ""), { singleLine: true,
      tooltip: ["账户 " + stamp(times.account), features.followers ? "粉丝 " + stamp(times.followers) : null,
        features.videos ? "视频 " + stamp(times.videos) : null,
