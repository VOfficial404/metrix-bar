function LoginPanel(width) {
  const busy = login.phase === "generating" || login.phase === "saving";
  const active = login.phase === "waiting" || login.phase === "scanned";
  const retry = login.phase === "expired" || login.phase === "error";
  const problem = login.phase === "idle" ? errors.account || (credential && inputError) : "";
  const message = login.phase === "idle" ? problem || "使用手机 App 扫码登录" : login.message;
  const action = busy ? login.phase === "saving" ? "正在连接…" : "生成中…" : active || retry ? "重新生成" : "扫码登录";
  const qrSize = Math.min(212, width);
