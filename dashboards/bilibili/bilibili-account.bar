    width: "100%", height: "100%", maxWidth: 320, minHeight: 0, minWidth: 0,
    padding: 16, gap: 12, radius: 24, background: "surface", textColor: "text", fontSize: 13,
    contextMenu, shortcuts: { "CmdOrCtrl+R": () => requestRefresh() } },
    connected ? IdentityHeader(now) : h("Row", { gap: 12, alignItems: "center", width: "100%" },
