<bar protocol-version="0" id="asf" title="ASF 挂卡"
     version="1.2.0" category="gaming" icon="data:image/svg+xml;base64,"
     description="查看 ArchiSteamFarm 账号、当前挂卡游戏与剩余卡牌，启动、停止、暂停和恢复账号。"
     license="AGPL-3.0-only" homepage="https://github.com/VOfficial404/metrix-bar"
     refresh="1m" material="solid">
  <permissions>
    <network origin="{{ inputs.base_url }}" />
    <network origin="https://avatars.steamstatic.com" />
    <network origin="https://store.steampowered.com" />
    <network origin="https://steamcommunity.com" />
  </permissions>
  <inputs>
    <input name="base_url" type="string" label="连接 · ASF IPC 地址" default="http://127.0.0.1:1242" required="true"
           help="填写 ASF 服务源地址，不带 /Api 路径。本机支持 HTTP，远程服务使用 HTTPS。" />
    <input name="ipc_key" type="secret" label="连接 · IPC 密码"
           help="填写 ASF 的 IPCPassword；未启用密码的本机服务可留空。密码保存在系统密钥库。" />
  </inputs>
  <docs><![CDATA[先运行 ArchiSteamFarm 并启用 IPC，在 ASF 中配置 Steam 账号及完成登录。在本看板设置填写 IPC 地址和可选的 IPCPassword。默认每分钟刷新，也可手动刷新。启动／停止控制账号运行；暂停／恢复仅控制挂卡，暂停持续到手动恢复或 ASF 重启。看板不会安装 ASF、保存 Steam 密码或处理 Steam Guard。]]></docs>
  <script apis="shell"><![CDATA[
const APP_ICON = "data:image/svg+xml;base64,";
const h = (type, props = {}, ...children) => ({ type, props, children: children.flat().filter(x => x != null && x !== false) });
const text = (value, props = {}) => h("Text", { text: String(value), fontSize: 13, ...props });
const note = (value, props = {}) => text(value, { fontSize: 11, textColor: "textMuted", ...props });
const ACTIONS = { Start: "启动", Stop: "停止", Pause: "暂停挂卡", Resume: "恢复挂卡" };
let config = null, setupError = "", bots = null, loadedAt = 0, error = "", result = "";
let generation = 0, controller = null, inflight = null, pending = "", stopped = false;
const gameNames = new Map();
class RequestError extends Error {}
function endpoint(value) {
  const u = new URL(String(value).trim());
  if (u.protocol !== "https:" && !(u.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(u.hostname))) throw new Error();
  if (u.href.includes("@") || u.search || u.hash || u.pathname !== "/") throw new Error();
  return u.origin;
}
function cancel() {
  generation++;
  controller?.abort(); controller = null; inflight = null; pending = "";
}
function sync(env) {
  let next = null, problem = "", key = "";
  try { key = $metrix.secret("ipc_key") || ""; } catch { /* Optional when local ASF has no IPCPassword. */ }
  try { next = { base: endpoint(env.inputs.base_url), key }; }
  catch { problem = "请填写有效的 ASF 服务源地址（远程 HTTPS 或本机 HTTP），不带路径、查询或 URL 账号信息。"; }
  if (next?.base === config?.base && next?.key === config?.key && problem === setupError) return;
  cancel(); config = next; setupError = problem;
  gameNames.clear();
  bots = null; loadedAt = 0; error = ""; result = "";
}
const integer = value => Number.isSafeInteger(value) && value >= 0;
function games(raw) {
  if (!Array.isArray(raw)) return null;
  return raw.map(g => {
    if (!g || !integer(g.AppID) || typeof g.GameName !== "string" || !integer(g.CardsRemaining)) throw new RequestError("ASF 游戏数据格式无效。");
    return { id: g.AppID, name: g.GameName, cards: g.CardsRemaining };
  });
}
function accounts(raw) {
  if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new RequestError("ASF 账号响应格式无效。");
  return Object.entries(raw).map(([name, b]) => {
    if (!b || b.BotName !== name || typeof b.KeepRunning !== "boolean" || typeof b.IsConnectedAndLoggedOn !== "boolean") throw new RequestError("ASF 账号状态格式无效。");
    const f = b.CardsFarmer;
    if (!f || typeof f.Paused !== "boolean" || typeof f.NowFarming !== "boolean") throw new RequestError("ASF 挂卡状态格式无效。");
    const available = b.KeepRunning && b.IsConnectedAndLoggedOn;
    const remaining = available ? games(f.GamesToFarm) : null, current = available ? games(f.CurrentGamesFarming) : null;
    const idleGames = Array.isArray(b.BotConfig?.GamesPlayedWhileIdle)
      ? b.BotConfig.GamesPlayedWhileIdle.filter(id => integer(id) && id > 0) : [];
    const idleLabel = typeof b.BotConfig?.CustomGamePlayedWhileIdle === "string" ? b.BotConfig.CustomGamePlayedWhileIdle : "";
    const avatar = typeof b.AvatarHash === "string" && /^[a-f0-9]{40}$/i.test(b.AvatarHash) && !/^0+$/.test(b.AvatarHash)
      ? "https://avatars.steamstatic.com/" + b.AvatarHash.toLowerCase() + "_medium.jpg" : "";
    const steamID = typeof b.s_SteamID === "string" && /^7656119\d{10}$/.test(b.s_SteamID) ? b.s_SteamID : "";
    return { name, nickname: typeof b.Nickname === "string" ? b.Nickname : "", avatar, idleGames, idleLabel, running: b.KeepRunning,
      steamID, steam: { state: "unknown", reason: steamID ? "正在读取 Steam 状态" : "ASF 未提供有效 Steam ID" },
      online: b.IsConnectedAndLoggedOn, playing: b.IsPlayingPossible, paused: f.Paused, farming: f.NowFarming,
      current, games: remaining?.length ?? null, cards: remaining ? remaining.reduce((sum, g) => sum + g.cards, 0) : null };
  }).sort((a, b) => a.name.localeCompare(b.name));
}
async function resolveGameNames(list, signal, version) {
  const ids = [...new Set(list.flatMap(bot => bot.idleGames))].filter(id => !gameNames.has(id));
  for (let offset = 0; offset < ids.length && !signal.aborted && version === generation; offset += 4) {
    await Promise.all(ids.slice(offset, offset + 4).map(async id => {
      try {
        const response = await fetch("https://store.steampowered.com/api/appdetails?appids=" + id + "&filters=basic&l=schinese",
          { signal, redirect: "error", headers: { Accept: "application/json" } });
        if (!response.ok) return;
        const app = (await response.json())?.[String(id)];
        if (version !== generation || signal.aborted || app?.success !== true || app.data?.steam_appid !== id) return;
        const name = app.data.name;
        if (typeof name === "string" && name.trim()) gameNames.set(id, name.trim());
      } catch { /* Public metadata is optional; retain App ID when unavailable. */ }
    }));
    if (version === generation) $metrix.invalidate();
  }
}
const idleGameName = id => gameNames.get(id) || "App " + id;
function xmlText(value) {
  return value.replace(/&(#x[0-9a-f]+|#\d+|amp|lt|gt|quot|apos);/gi, (_, entity) => {
    const named = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" };
    if (Object.hasOwn(named, entity)) return named[entity];
    const code = entity[1]?.toLowerCase() === "x" ? parseInt(entity.slice(2), 16) : Number(entity.slice(1));
    return code > 0 && code <= 0x10ffff && !(code >= 0xd800 && code <= 0xdfff) ? String.fromCodePoint(code) : "�";
  });
}
function steamProfile(xml, steamID) {
  if (typeof xml !== "string" || xml.length > 1048576 || /<!DOCTYPE|<!ENTITY/i.test(xml)) throw new Error("Invalid Steam XML");
  const wanted = new Set(["profile/steamID64", "profile/privacyState", "profile/onlineState", "profile/inGameInfo/gameName", "profile/inGameInfo/gameLink"]);
  const fields = {}, stack = [];
  let root = false, position = 0;
  const tokens = /<!\[CDATA\[([\s\S]*?)\]\]>|<!--[\s\S]*?-->|<\?[\s\S]*?\?>|<\/([\w]+)\s*>|<([\w]+)(?:\s+[^<>]*?)?\s*(\/?)>|([^<]+)/g;
  for (const match of xml.matchAll(tokens)) {
    if (match.index !== position) throw new Error("Invalid Steam XML");
    position += match[0].length;
    if (match[2]) {
      if (stack.pop() !== match[2]) throw new Error("Invalid Steam XML");
    } else if (match[3]) {
      if (!stack.length) { if (root || match[3] !== "profile") throw new Error("Invalid Steam profile"); root = true; }
      if (!match[4]) stack.push(match[3]);
    } else if (match[1] !== undefined || match[5] !== undefined) {
      const path = stack.join("/");
      if (wanted.has(path)) fields[path] = (fields[path] || "") + (match[1] !== undefined ? match[1] : xmlText(match[5]));
    }
  }
  if (!root || stack.length || position !== xml.length || fields["profile/steamID64"]?.trim() !== steamID) throw new Error("Steam identity mismatch");
  if (fields["profile/privacyState"]?.trim() !== "public") return { state: "unknown", reason: "Steam 资料非公开，无法确认游戏状态" };
  const state = fields["profile/onlineState"]?.trim();
  if (!["online", "offline", "in-game"].includes(state)) throw new Error("Unknown Steam presence");
  let appID = null;
  try {
    const link = new URL(fields["profile/inGameInfo/gameLink"]?.trim());
    const match = /^\/app\/(\d+)(?:\/|$)/.exec(link.pathname);
    if (["https:", "http:"].includes(link.protocol) && ["store.steampowered.com", "steamcommunity.com"].includes(link.hostname) && match && integer(Number(match[1])) && Number(match[1]) > 0) appID = Number(match[1]);
  } catch { /* Non-Steam games may have no store link. */ }
  return { state, appID: state === "in-game" ? appID : null,
    game: state === "in-game" ? fields["profile/inGameInfo/gameName"]?.trim() || "未公开游戏名称" : "", at: Date.now() };
}
async function resolveSteamPresence(list, signal, version) {
  const ids = [...new Set(list.map(bot => bot.steamID).filter(Boolean))];
  for (let offset = 0; offset < ids.length && !signal.aborted && version === generation; offset += 4) {
    await Promise.all(ids.slice(offset, offset + 4).map(async id => {
      let presence;
      try {
        const response = await fetch("https://steamcommunity.com/profiles/" + id + "/?xml=1", { signal, redirect: "error", headers: { Accept: "text/xml" } });
        if (!response.ok) throw new Error("Steam unavailable");
        presence = steamProfile(await response.text(), id);
      } catch { presence = { state: "unknown", reason: "Steam 状态读取失败，无法确认当前游戏" }; }
      if (version !== generation || signal.aborted) return;
      for (const bot of list) if (bot.steamID === id) bot.steam = presence;
    }));
    if (version === generation) $metrix.invalidate();
  }
  if (version === generation) for (const bot of list) {
    if (bot.steam.reason === "正在读取 Steam 状态") bot.steam = { state: "unknown", reason: "Steam 状态读取超时，无法确认当前游戏" };
  }
}
function steamComparison(bot) {
  const steam = bot.steam;
  if (error) return "Steam 状态已过期，请刷新后确认";
  if (steam.state === "unknown") return steam.reason;
  if (steam.state !== "in-game") return steam.state === "offline" ? "Steam 显示离线／隐身，无法确认游戏是否运行" : "Steam 未公开显示游戏；可能未运行或游戏详情不可见";
  const game = steam.game || idleGameName(steam.appID);
  if (steam.appID === null) return "Steam 正在运行：" + game + "（未提供 App ID，无法核对配置）";
  if (farmingNow(bot)) return "Steam 正在运行：" + game + (bot.current?.some(g => g.id === steam.appID) ? " · 与卡牌挂卡一致" : " · 与 ASF 当前挂卡列表不一致");
  if (bot.idleGames.includes(steam.appID)) return "Steam 正在运行：" + game + " · 匹配空闲游戏配置";
  return "Steam 正在运行：" + game + (bot.idleGames.length ? " · 不在空闲游戏配置中" : " · 未配置空闲游戏");
}
async function request(connection, path, signal, action) {
  const headers = { Accept: "application/json" };
  if (connection.key) headers.Authentication = connection.key;
  const options = { headers, signal, redirect: "error", method: action ? "POST" : "GET" };
  if (action === "Pause") {
    headers["Content-Type"] = "application/json";
    options.body = JSON.stringify({ Permanent: true, ResumeInSeconds: 0 });
  }
  const response = await fetch(connection.base + "/Api/Bot/" + path, options);
  if ([401, 403].includes(response.status)) throw new RequestError("ASF 拒绝访问，请检查 IPC 密码和访问配置。");
  if (response.status === 429) throw new RequestError("ASF 暂时限制请求，请稍后刷新。");
  if (!response.ok) throw new RequestError("ASF 请求失败（HTTP " + response.status + "）。");
  let body;
  try { body = await response.json(); } catch { throw new RequestError("ASF 返回了无效的 JSON，请检查 IPC 地址。"); }
  if (body?.Success !== true) throw new RequestError(action ? "ASF 未确认操作成功，请在 ASF 管理页查看原因。" : "ASF 未能返回账号，请检查服务及账号配置。");
  return body.Result;
}
const safeError = e => e instanceof RequestError ? e.message : "无法连接 ASF 或请求超时，请检查服务和 IPC 地址。";
function refresh() {
  if (!config || stopped) return Promise.resolve();
  if (inflight) return inflight;
  const version = generation, connection = config, abort = new AbortController();
  controller = abort;
  const timer = setTimeout(() => abort.abort(), 10000);
  inflight = (async () => {
    try {
      const next = accounts(await request(connection, "ASF", abort.signal));
      if (version !== generation) return;
      bots = next; loadedAt = Date.now(); error = "";
      $metrix.invalidate();
      await Promise.all([resolveSteamPresence(next, abort.signal, version), resolveGameNames(next, abort.signal, version)]);
    } catch (e) { if (version === generation) error = safeError(e); }
    finally {
      clearTimeout(timer);
      if (version === generation) { inflight = null; controller = null; $metrix.invalidate(); }
    }
  })();
  $metrix.invalidate();
  return inflight;
}
// ASF's path parameter also accepts selectors; never let one row target several bots.
const exactName = name => name && name.toUpperCase() !== "ASF" && !name.startsWith("@") && !/^r!/i.test(name) && !name.includes(",") && !name.includes("..");
async function control(name, action, expectedGeneration) {
  if (!config || stopped || pending || error || expectedGeneration !== generation || !Object.hasOwn(ACTIONS, action) || !exactName(name)) return;
  const bot = bots?.find(b => b.name === name);
  if (!bot || (action === "Start" ? bot.running : action === "Stop" ? !bot.running : !bot.online || (action === "Pause" ? bot.paused : !bot.paused))) return;
  cancel();
  const version = generation, connection = config, abort = new AbortController();
  controller = abort; pending = name; result = "";
  const timer = setTimeout(() => abort.abort(), 12000);
  const operation = (async () => {
    let accepted = false;
    try {
      await request(connection, encodeURIComponent(name) + "/" + action, abort.signal, action);
      accepted = true;
      if (version !== generation) return;
      result = name + "：ASF 已接受“" + ACTIONS[action] + "”。";
      const next = accounts(await request(connection, "ASF", abort.signal));
      if (version !== generation) return;
      bots = next; loadedAt = Date.now(); error = "";
      $metrix.invalidate();
      await Promise.all([resolveSteamPresence(next, abort.signal, version), resolveGameNames(next, abort.signal, version)]);
    } catch (e) {
      if (version === generation) error = (accepted ? "操作已接受，但状态刷新失败。" : "操作未确认，请刷新核对状态后再操作。") + safeError(e);
    } finally {
      clearTimeout(timer);
      if (version === generation) { pending = ""; controller = null; inflight = null; $metrix.invalidate(); }
    }
  })();
  inflight = operation; $metrix.invalidate();
  await operation;
}
const farmingNow = bot => bot.running && bot.online && bot.playing !== false && bot.farming && !bot.paused;
function currentGamesText(bot) {
  if (!bot.running || !bot.online) return "未连接 Steam，当前游戏与卡牌队列未知";
  if (bot.paused) return "卡牌挂卡已暂停";
  if (bot.playing === false) return "游戏被占用，无法挂卡";
  if (farmingNow(bot)) return bot.current?.length ? bot.current.map(g => g.name || "App " + g.id).join("、") : "正在挂卡，游戏列表暂不可用";
  return "当前未进行卡牌挂卡";
}
function steamStatus(bot) {
  if (error || bot.steam.state === "unknown") return ["Steam 未知", "textMuted", "#8995A2"];
  if (bot.steam.state === "in-game") return ["Steam 游戏中", "success", "#A4D007"];
  if (bot.steam.state === "online") return ["Steam 在线", "textMuted", "#66C0F4"];
  return ["Steam 离线", "textMuted", "#8995A2"];
}
function status(bot) {
  if (!bot.running) return ["已停止", "textMuted", "#8995A2"];
  if (!bot.online) return ["连接中／等待登录", "warning", "#E5B45A"];
  if (bot.paused) return ["挂卡已暂停", "warning", "#E5B45A"];
  if (bot.playing === false) return ["游戏占用", "warning", "#E5B45A"];
  return bot.farming ? ["正在挂卡", "success", "#A4D007"] : ["在线待机", "textMuted", "#66C0F4"];
}
function botRow(bot) {
  const [label, color, light] = steamStatus(bot), version = generation;
  const unavailable = Boolean(inflight || error || !exactName(bot.name));
  const button = action => h("Button", { key: "action-" + bot.name + "-" + action, text: ACTIONS[action],
    disabled: unavailable || ((action === "Pause" || action === "Resume") && !bot.online),
    onClick: () => control(bot.name, action, version) });
  return h("Column", { key: "bot-" + bot.name, gap: 8, padding: 14, fillWidth: true, minWidth: 0 },
    h("Row", { gap: 8, alignItems: "center", fillWidth: true },
      h("Avatar", { key: "avatar-" + bot.name, name: bot.nickname || bot.name, src: bot.avatar, width: 32, height: 32, radius: 16, fit: "cover", shrink: 0 }),
      h("Column", { grow: 1, minWidth: 0, gap: 2 },
        text(bot.nickname || bot.name, { bold: true, maxLines: 1, tooltip: bot.name }),
        bot.nickname && bot.nickname !== bot.name ? note(bot.name) : null),
      h("Row", { gap: 5, alignItems: "center", shrink: 0, tooltip: label },
        h("Box", { key: "status-light-" + bot.name, width: 8, height: 8, radius: 4, background: light, shrink: 0, label }),
        text(label, { key: "steam-status-" + bot.name, fontSize: 11, textColor: color }))),
    h("Row", { gap: 4 }, note("ASF："), note(status(bot)[0], { key: "status-" + bot.name, textColor: status(bot)[1] })),
    text(steamComparison(bot), { key: "steam-comparison-" + bot.name, fontSize: 12, maxLines: 3 }),
    bot.steam.at && !error ? note("Steam 核对于 " + new Date(bot.steam.at).toLocaleTimeString(), { fontSize: 10 }) : null,
    text(currentGamesText(bot), { key: "games-" + bot.name, maxLines: 2 }),
    bot.idleGames.length || bot.idleLabel ? h("Column", { gap: 2, fillWidth: true },
      note("空闲游戏配置：" + (bot.idleGames.length ? bot.idleGames.map(idleGameName).join("、") : "自定义状态"),
        { key: "idle-" + bot.name, maxLines: 2, tooltip: bot.idleGames.map(id => idleGameName(id) + " · App " + id).join("\n") }),
      bot.idleLabel ? note("自定义名称：" + bot.idleLabel, { maxLines: 1, tooltip: bot.idleLabel }) : null,
      note("Steam 仅公开一个游戏；不能确认全部配置项或由哪个客户端运行", { fontSize: 10, maxLines: 2 })) : null,
    h("Row", { gap: 16 }, note("剩余卡牌 " + (bot.cards ?? "—")), note("剩余游戏 " + (bot.games ?? "—"))),
    h("Row", { gap: 8, alignItems: "center" }, button(bot.running ? "Stop" : "Start"), button(bot.paused ? "Resume" : "Pause"),
      pending === bot.name ? note("正在处理…") : null),
    !exactName(bot.name) ? note("此账号名称包含 ASF 选择器语法，请在 ASF 管理页操作。") : null);
}
function panel() {
  const online = bots?.filter(b => b.online).length;
  const farming = bots?.filter(farmingNow).length;
  const onlineBots = bots?.filter(b => b.running && b.online) || [];
  const cards = onlineBots.length && onlineBots.every(b => b.cards !== null) ? onlineBots.reduce((sum, b) => sum + b.cards, 0) : "—";
  return h("Column", { preferredWidth: 440, preferredHeight: Math.min(780, 180 + (bots?.length || 1) * 280),
    safeArea: true, fill: true, minWidth: 0, minHeight: 0, shortcuts: { "CmdOrCtrl+R": () => refresh() } },
    h("Row", { padding: 14, gap: 8, alignItems: "center", fillWidth: true }, text("ASF 挂卡", { bold: true, grow: 1 }),
      h("Button", { key: "refresh", text: inflight ? "更新中…" : "刷新", disabled: !config || Boolean(inflight), onClick: () => refresh() }),
      h("Button", { text: "管理页", disabled: !config, onClick: () => config && $metrix.openURL(config.base + "/") })),
    bots ? h("Row", { padding: [0, 14, 12, 14], gap: 12 }, note("ASF 在线 " + online + "/" + bots.length), note("卡牌挂卡 " + farming), note("在线队列卡牌 " + cards)) : null,
    h("Divider"),
    h("Scroll", { grow: 1, minHeight: 0, fillWidth: true }, h("Column", { fillWidth: true },
      setupError || error ? text(setupError || error, { key: "error", padding: 14, fontSize: 12, textColor: "danger" }) : null,
      result ? note(result, { key: "result", padding: [8, 14] }) : null,
      bots === null ? note(config ? inflight ? "正在读取 ASF 账号…" : "在设置中连接 ASF，然后点击刷新。" : "请先配置 ASF IPC 连接。", { padding: 14 }) :
        bots.length ? bots.flatMap((b, i) => [i ? h("Divider") : null, botRow(b)]) : note("ASF 中还没有账号，请在管理页添加并完成登录。", { key: "empty", padding: 14 }))),
    h("Divider"), note((error && loadedAt ? "数据已过期 · " : "") + (loadedAt ? "更新于 " + new Date(loadedAt).toLocaleTimeString() : "尚未更新") + " · 每分钟刷新", { padding: [10, 14] }));
}
export default {
  async scheduled(env) { sync(env); await refresh(); },
  render(env) {
    sync(env);
    const count = bots?.filter(farmingNow).length;
    return { tray: { title: count == null ? "ASF" : "ASF " + count, icon: APP_ICON, iconTemplate: false, error: setupError || error,
      tooltip: count == null ? "ArchiSteamFarm" : count + " 个账号正在进行卡牌挂卡（不含空闲游戏配置）",
      menu: [{ label: "刷新", onClick: () => refresh(), disabled: !config || Boolean(inflight) }] }, panel: panel() };
  },
  event(name, payload) {
    if (name !== "lifecycle") return;
    if (payload?.type === "stop") { stopped = true; cancel(); }
    if (payload?.type === "start") stopped = false;
    if (payload?.type === "expand" && Date.now() - loadedAt >= 60000) return refresh();
  },
};
  ]]></script>
</bar>
