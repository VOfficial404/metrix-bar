function sync(env) {
  lastEnv = env;
  const minutes = env.inputs.global_refresh_minutes;
  const nextGlobalMinutes = Number.isSafeInteger(minutes) && minutes >= 1 && minutes <= 1440 ? minutes : 60;
  if (nextGlobalMinutes !== globalRefreshMinutes) {
    if (uiLive) $metrix.schedule(nextGlobalMinutes * 60000);
    globalRefreshMinutes = nextGlobalMinutes;
  }
  privateCardSize = env.inputs.private_card_size === "compact" ? "compact" : "normal";
  for (const key of ["identity", "followers", "daily", "level"]) {
    const size = env.inputs["account_" + key + "_size"];
    accountSizes[key] = ACCOUNT_SIZES[size === "normal" || size === "large" ? size : "compact"];
  }
  const chartHeight = env.inputs.follower_chart_height, panelHeight = env.inputs.account_panel_height;
  followerChartHeight = Number.isSafeInteger(chartHeight) && chartHeight >= 80 && chartHeight <= 240 ? chartHeight : 100;
  accountPanelHeight = Number.isSafeInteger(panelHeight) && panelHeight >= 280 && panelHeight <= 900 ? panelHeight : 560;
  let next = "";
  try { next = String($metrix.secret("sessdata") || "").trim(); } catch {}
  const limit = Number(env.inputs.video_count || "5");
  const rate = PRIVATE_RATES[env.inputs.private_refresh]?.ms ? env.inputs.private_refresh : "10m";
  const display = env.inputs.private_display === "list" ? "list" : "summary";
  const requestedPrivateLimit = Number(env.inputs.private_count || "5");
  const nextPrivateLimit = [3, 5, 10].includes(requestedPrivateLimit) ? requestedPrivateLimit : 5;
  const nextFeatures = Object.fromEntries(FEATURE_KEYS.map(key => [key, env.inputs["show_" + key] !== false]));
  if (!nextFeatures.account) for (const key of ["identity", "followers", "level"]) nextFeatures[key] = false;
  const nextMenuRanks = TABS.map((item, index) => Number.isSafeInteger(env.inputs["order_" + item.id])
    ? env.inputs["order_" + item.id] : (index + 1) * 10);
  const menuChanged = nextMenuRanks.some((rank, index) => rank !== menuRanks[index]);
  if (menuChanged) menuRanks = nextMenuRanks;
  const featuresChanged = FEATURE_KEYS.some(key => nextFeatures[key] !== features[key]);
  if (initialized && next === credential && limit === videoLimit && rate === privateRate
      && display === privateDisplay && nextPrivateLimit === privateLimit && !featuresChanged) {
    if (menuChanged) updateTabs();
    return;
  }
  const changedAccount = !initialized || next !== credential;
  const firstSync = !initialized;
  if (firstSync) {
    let saved;
    try { saved = JSON.parse(localStorage.getItem("follower-chart:v1") || "null"); } catch {}
    followerChart = { days: [7, 14, 30].includes(saved?.days) ? saved.days : 7,
      metric: FOLLOWER_METRICS.some(item => item.value === saved?.metric) ? saved.metric : "net" };
  }
  initialized = true;
  generation++;
  refreshController?.abort();
  cancelPrivateRefresh();
  cancelDynamicRefresh();
  credential = next;
  videoLimit = [3, 5, 10].includes(limit) ? limit : 5;
  if (rate !== privateRate) privateAttemptAt = Date.now();
  privateRate = rate;
  privateDisplay = display;
  privateLimit = nextPrivateLimit;
  features = nextFeatures;
  updateTabs(firstSync);
  inputError = !next ? "扫码登录以连接自己的 B 站账户。"
    : /[\s;\r\n]/.test(next) || /^SESSDATA=/i.test(next) ? "只填写 SESSDATA 的值，不要填写整段 Cookie。" : "";
  if (changedAccount) {
    account = followers = videos = privateMessages = notifications = conversations = null;
    followerDaily = followerTrend = null;
    followerChartError = "";
    dynamics = null;
    dynamicFilterUID = null;
    dynamicFilter = { mode: "all", uids: [] };
    dynamicSearch = dynamicUIDDraft = dynamicFilterError = "";
    dynamicFilterOpen = false;
    times = {};
    errors = {};
    privateAttemptAt = 0;
  }
  if (!features.followers) {
    followers = followerDaily = followerTrend = null;
    followerChartError = "";
    delete times.followers;
    delete errors.followers;
    delete times.followerDaily;
    delete errors.followerDaily;
    delete times.followerTrend;
    delete errors.followerTrend;
  }
  if (!features.videos) {
    videos = null;
    delete times.videos;
    delete errors.videos;
  }
  if (!privateEnabled()) {
    privateMessages = null;
    delete times.private;
    delete errors.private;
    privateAttemptAt = 0;
  }
  if (!privateEnabled() || privateDisplay !== "list") {
    conversations = null;
    delete times.conversations;
    delete errors.conversations;
  }
  if (!notificationsEnabled()) {
    notifications = null;
    delete times.notifications;
    delete errors.notifications;
  }
  if (!features.dynamic) {
    dynamics = null;
    delete times.dynamic;
    delete errors.dynamic;
  }
  armPrivateRefresh();
}

class RequestError extends Error {}
async function get(origin, path, session, signal) {
  let response;
  try {
    response = await fetch(origin + path, {
      headers: { Cookie: "SESSDATA=" + session, Referer: origin === MEMBER ? MEMBER + "/platform/upload-manager/article" : "https://www.bilibili.com/" },
      redirect: "error", signal,
    });
  } catch { throw new RequestError("网络请求失败或超时，请稍后手动刷新。"); }
  let payload;
  try { payload = await response.json(); }
  catch { throw new RequestError(response.ok ? "B 站返回了非 JSON 响应，可能触发风控。" : "请求失败：HTTP " + response.status); }
  if (!response.ok) throw new RequestError("请求失败：HTTP " + response.status);
  if (payload.code === -101 || payload.code === -111 || payload.code === -6) throw new RequestError("登录会话已失效，请重新扫码登录。");
  if (payload.code === -352 || payload.code === -412 || payload.data?.v_voucher) throw new RequestError("B 站风控校验未通过，请稍后刷新并检查网页版登录状态。");
  if (payload.code !== 0 || !payload.data) throw new RequestError("B 站接口返回错误（" + (Number.isFinite(payload.code) ? payload.code : "未知") + "）。");
  return payload.data;
}
function invalid() { throw new RequestError("B 站接口数据结构已变化，暂时无法读取。"); }
function imageURL(value) {
  if (typeof value !== "string" || !value.trim()) return "";
  try {
    const url = new URL(value.startsWith("//") ? "https:" + value : value);
    if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.port
        || !["i0.hdslb.com", "i1.hdslb.com", "i2.hdslb.com"].includes(url.hostname)) return "";
    url.protocol = "https:";
    return url.href;
  } catch { return ""; }
}
function readAccount(data) {
  if (data.isLogin !== true) throw new RequestError("登录会话已失效，请重新扫码登录。");
  const lv = data.level_info;
  if (!count(data.mid) || data.mid === 0 || typeof data.uname !== "string" || !metric(data.money)
      || !lv || !count(lv.current_level) || !count(lv.current_exp) || !count(lv.current_min)) invalid();
  const maxLevel = lv.current_level >= 6;
  if (!maxLevel && (!count(lv.next_exp) || lv.next_exp <= lv.current_min)) invalid();
  return { uid: data.mid, name: data.uname, avatar: imageURL(data.face), senior: data.is_senior_member === 1,
    coins: data.money, level: lv.current_level, xp: lv.current_exp, floor: lv.current_min, next: maxLevel ? null : lv.next_exp };
}
function readFollowers(uid, data) {
  if (data.mid !== uid || !count(data.follower) || !count(data.following)) invalid();
  return { count: data.follower, following: data.following };
}
function yesterdayDate(now = Date.now()) {
  return new Date(now + 8 * 3600000 - 86400000).toISOString().slice(0, 10);
}
function readFollowerDaily(data) {
  if (!count(data.follow) || !count(data.unfollow) || !Number.isSafeInteger(data.log_date)
      || !/^\d{8}$/.test(String(data.log_date))) invalid();
  const date = String(data.log_date).replace(/^(\d{4})(\d{2})(\d{2})$/, "$1-$2-$3");
  const parsed = Date.parse(date + "T00:00:00Z");
  if (!Number.isFinite(parsed) || new Date(parsed).toISOString().slice(0, 10) !== date
      || date > yesterdayDate()) invalid();
  return { follow: data.follow, unfollow: data.unfollow, net: data.follow - data.unfollow, date };
}
function readFollowerGraph(data) {
  if (!Array.isArray(data.tendency) || data.tendency.length > 31) invalid();
  const days = new Map();
  for (const row of data.tendency) {
    if (!row || !count(row.date_key) || row.date_key > Math.floor(Date.now() / 1000) || !count(row.total_inc)) invalid();
    const day = row.date_key * 1000 + 8 * 3600000;
    if (day % 86400000 !== 0 || days.has(day)) invalid();
    if (new Date(day).toISOString().slice(0, 10) > yesterdayDate()) invalid();
    days.set(day, row.total_inc);
