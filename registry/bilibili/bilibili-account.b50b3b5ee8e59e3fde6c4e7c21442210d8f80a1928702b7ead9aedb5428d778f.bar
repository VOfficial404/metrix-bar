      const items = prior ? [...prior.items] : [], seen = new Set(items.map(item => item.id));
      for (const item of next.items) if (!seen.has(item.id) && items.length < 100) { seen.add(item.id); items.push(item); }
      dynamics = { ...next, items, cursors: prior ? [...prior.cursors, prior.offset] : [] };
      times.dynamic = Date.now();
      delete errors.dynamic;
