  }
  return { items, hasMore: data.has_more, offset: data.has_more ? data.offset : "" };
}
function cancelDynamicRefresh() {
  dynamicController?.abort();
  dynamicController = dynamicInflight = null;
}
function refreshDynamics(more = false, parentSignal) {
  if (inputError || !features.dynamic || !account || parentSignal?.aborted) return Promise.resolve();
  if (dynamicInflight) {
    if (more) return dynamicInflight;
    cancelDynamicRefresh();
  }
  if (more && (!dynamics?.hasMore || dynamics.items.length >= 100)) return Promise.resolve();
  const version = generation, uid = account.uid, session = credential, prior = more ? dynamics : null;
  const controller = new AbortController(), cancel = () => controller.abort();
  const timeout = setTimeout(cancel, 8000);
  parentSignal?.addEventListener("abort", cancel, { once: true });
  dynamicController = controller;
  const current = () => version === generation && account?.uid === uid && dynamicController === controller && features.dynamic;
  const query = new URLSearchParams({ type: "all" });
  if (prior) query.set("offset", prior.offset);
  const task = (async () => {
    try {
      const data = await get(API, "/x/polymer/web-dynamic/v1/feed/all?" + query, session, controller.signal);
      if (!current()) return;
      if (controller.signal.aborted) throw new RequestError("动态读取已取消或超时，请重试。");
      const next = readDynamics(data);
