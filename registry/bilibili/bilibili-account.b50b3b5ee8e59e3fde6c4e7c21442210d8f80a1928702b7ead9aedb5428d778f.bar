      startMotion();
      if (!privateLive) privateAttemptAt = Date.now();
      privateLive = true;
      armPrivateRefresh();
    }
    if (name === "lifecycle" && payload?.type === "stop") {
      generation++;
      refreshController?.abort();
      cancelDynamicRefresh();
      privateLive = false;
      cancelPrivateRefresh();
      uiLive = false;
      stopMotion();
      reducedQuery?.removeEventListener("change", motionPreferenceChanged);
      reducedQuery = null;
      cancelLogin(false);
    }
  },
};
  ]]></script>
</bar>
