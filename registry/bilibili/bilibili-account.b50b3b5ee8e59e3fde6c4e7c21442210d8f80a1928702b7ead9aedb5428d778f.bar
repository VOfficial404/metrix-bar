      const comparison = delta == null ? "首次成功采样，建立对比基线" : "较 " + stamp(video.since) + "：" + signed(delta);
      return h("Column", { gap: 0, minWidth: 0, tooltip: comma(video[field]) + "\n" + comparison },
        note(label), text(compact(video[field]), { key: video.id + "-" + label, fontSize: 13, fontFeatures: "tnum", singleLine: true }),
        text(change, { key: "delta-" + video.id + "-" + field, fontSize: 10, minWidth: 0, singleLine: true,
          fontFeatures: "tnum", textColor: delta > 0 ? "success" : delta < 0 ? "danger" : "textMuted" }));
    });
    const heading = h("Row", { gap: 8, width: "100%", minWidth: 0, alignItems: "center" },
      features.video_cover && video.cover ? h("Image", { key: video.id + "-cover", src: video.cover, width: 88, height: 50,
        fit: "cover", radius: 6, clip: true, shrink: 0, label: video.title + "封面" }) : null,
      h("Column", { gap: 4, grow: 1, minWidth: 0 },
        text(video.title, { fontSize: 13, fontWeight: 500, maxLines: 2, wrap: true, minWidth: 0 }),
        features.video_date ? note(stamp(video.published), { key: video.id + "-date", singleLine: true, minWidth: 0, tooltip: video.id }) : null));
    return h("ButtonBase", { key: video.id, padding: 12, radius: 12, background: "surfaceHover",
      width: "100%", minWidth: 0, ...pressStyle(), onClick: launch("https://www.bilibili.com/video/" + video.id),
      label: video.title, tooltip: video.title, hover: { background: "surfacePressed" }, focusRing: true },
      h("Column", { gap: 8, width: "100%", minWidth: 0 }, heading,
