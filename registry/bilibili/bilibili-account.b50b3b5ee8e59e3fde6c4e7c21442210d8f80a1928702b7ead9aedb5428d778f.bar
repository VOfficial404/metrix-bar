// Official Bilibili header level SVG fills, verified 2026-11-09.
const LEVEL_COLORS = ["#C0C0C0", "#C0C0C0", "#8BD29B", "#7BCDEF", "#FEBB8B", "#EE672A", "#FF0000"];
