    combined: value("recv_reply"), likes: value("recv_like") ?? value("like"),
    system: value("sys_msg"), assistant: value("up"), coins: value("coin"), favorites: value("favorite") };
  if (Object.values(result).every(v => v === null)) invalid();
  return result;
}
function dynamicExcerpt(item, forwarded = false) {
  const content = item?.modules?.module_dynamic;
  if (!content) return "动态内容暂不可用，请打开原文查看。";
  const major = content.major;
  if (major?.type === "MAJOR_TYPE_NONE") return "原动态已失效";
  const parts = [content.desc?.text, major?.archive?.title, major?.opus?.title, major?.opus?.summary?.text,
    major?.article?.title, major?.common?.title, major?.music?.title, major?.pgc?.title];
  if (!forwarded && item.type === "DYNAMIC_TYPE_FORWARD") {
    const author = item.orig?.modules?.module_author?.name;
    parts.push(item.orig ? "转发" + (typeof author === "string" ? " @" + author : "") + "：" + dynamicExcerpt(item.orig, true) : "原动态已失效");
  }
  return [...new Set(parts.filter(value => typeof value === "string" && value.trim()).map(value => value.trim()))].join("\n").slice(0, 600)
    || (major?.type === "MAJOR_TYPE_DRAW" ? "图片动态，请打开原文查看。" : "此类动态请打开原文查看。");
}
function readDynamics(data) {
  if (!Array.isArray(data.items) || typeof data.has_more !== "boolean"
      || (data.has_more && (typeof data.offset !== "string" || !data.offset || data.offset.length > 256))) invalid();
  const seen = new Set(), items = [];
  for (const item of data.items) {
    if (item?.visible === false) continue;
    const author = item?.modules?.module_author;
    const published = typeof author?.pub_ts === "string" && /^\d{1,16}$/.test(author.pub_ts)
      ? Number(author.pub_ts) : author?.pub_ts;
    if (typeof item?.id_str !== "string" || !/^[1-9]\d{0,31}$/.test(item.id_str) || !author
        || !count(author.mid) || !author.mid || typeof author.name !== "string" || !count(published)
        || !Number.isSafeInteger(published * 1000) || !item.modules.module_dynamic) invalid();
    if (seen.has(item.id_str)) continue;
    seen.add(item.id_str);
    items.push({ id: item.id_str, uid: String(author.mid), name: author.name.trim() || "UID " + author.mid,
