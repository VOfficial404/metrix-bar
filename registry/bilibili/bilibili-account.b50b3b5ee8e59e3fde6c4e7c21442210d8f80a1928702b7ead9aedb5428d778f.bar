  return days;
}
async function loadFollowerTrend(session, signal) {
  const follow = readFollowerGraph(await get(MEMBER, "/x/web/data/v2/fans/stat/graph?type=follow&period=1", session, signal));
  const unfollow = readFollowerGraph(await get(MEMBER, "/x/web/data/v2/fans/stat/graph?type=unfollow&period=1", session, signal));
  return [...new Set([...follow.keys(), ...unfollow.keys()])].sort((a, b) => a - b).map(day => ({ day,
    follow: follow.get(day) ?? null, unfollow: unfollow.get(day) ?? null,
    net: follow.has(day) && unfollow.has(day) ? follow.get(day) - unfollow.get(day) : null }));
}
function saveFollowerChart(next) {
  if (!features.followers || ![7, 14, 30].includes(next.days) || !FOLLOWER_METRICS.some(item => item.value === next.metric)) return;
  try { localStorage.setItem("follower-chart:v1", JSON.stringify(next)); }
  catch { followerChartError = "图表偏好保存失败，请重试。"; $metrix.invalidate(); return; }
  followerChart = next;
  followerChartError = "";
  $metrix.invalidate();
}
function readPrivate(data) {
