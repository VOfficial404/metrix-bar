function conversationPreview(message) {
  if (!message) return "暂无消息内容";
  if (message.sys_cancel || message.msg_status === 1 || message.msg_status === 2
      || message.msg_type === 5 || message.msg_type === 8) return "[消息已撤回]";
  if (message.msg_status === 50) return "[图片已失效]";
  if (message.msg_type === 2) return "[图片]";
  if (message.msg_type === 6) return "[表情]";
  if (![1, 7, 10, 11].includes(message.msg_type)) return "[其他消息]";
  let content;
  try { content = JSON.parse(message.content); } catch { return "[消息内容暂不可用]"; }
  const title = typeof content?.title === "string" ? content.title : "";
  const value = message.msg_type === 1 ? content?.content
    : message.msg_type === 10 ? [title, content?.text].filter(part => typeof part === "string" && part).join("：")
    : (message.msg_type === 7 ? "[分享] " : "[视频推送] ") + title;
  return typeof value === "string" && value.trim()
    ? value.replace(/\s+/g, " ").trim().slice(0, 160) : "[消息内容暂不可用]";
}
async function loadConversations(uid, session, signal) {
  const rows = [], seen = new Set();
  let end = null;
  while (rows.length < privateLimit) {
    if (signal.aborted) throw new RequestError("会话读取已取消或超时。");
    const query = "?session_type=1&group_fold=1&unfollow_fold=0&sort_rule=2&size=20&build=0&mobi_app=web"
      + (end === null ? "" : "&end_ts=" + end);
    const data = await get(IM, "/session_svr/v1/session_svr/get_sessions" + query, session, signal);
    if (!(data.session_list === null || Array.isArray(data.session_list)) || ![0, 1].includes(data.has_more)) invalid();
    const list = data.session_list || [];
    let cursor = Infinity;
    for (const item of list) {
      if (!item || !count(item.session_type) || !count(item.session_ts)) invalid();
      cursor = Math.min(cursor, item.session_ts);
    }
    if (end !== null && list.length && cursor >= end) invalid();
    list.sort((a, b) => b.session_ts - a.session_ts);
    for (const item of list) {
      if (item.session_type !== 1) continue;
      if ((item.system_msg_type != null && !count(item.system_msg_type))
          || (item.is_intercept != null && !count(item.is_intercept))) invalid();
      if (item.system_msg_type || item.is_intercept) continue;
      if (!count(item.talker_id) || !item.talker_id || !count(item.unread_count)) invalid();
      if (item.talker_id === uid || seen.has(item.talker_id)) continue;
      const message = item.last_msg;
      if (message !== null) {
        if (!message || message.receiver_type !== 1 || !count(message.sender_uid) || !count(message.receiver_id)
            || !count(message.msg_type) || !count(message.timestamp) || !Number.isSafeInteger(message.timestamp * 1000)) invalid();
        if (!(message.sender_uid === item.talker_id && message.receiver_id === uid)
            && !(message.sender_uid === uid && message.receiver_id === item.talker_id)) invalid();
      }
      seen.add(item.talker_id);
      rows.push({ uid: item.talker_id, unread: item.unread_count, sessionAt: item.session_ts,
        at: message ? message.timestamp * 1000 : Math.floor(item.session_ts / 1000),
        preview: (message?.sender_uid === uid ? "我：" : "") + conversationPreview(message) });
    }
    if (rows.length >= privateLimit || !data.has_more) break;
    if (!list.length || !count(cursor) || !cursor) invalid();
    end = cursor;
  }
  rows.sort((a, b) => b.sessionAt - a.sessionAt || a.uid - b.uid);
  const selected = rows.slice(0, privateLimit);
  if (!selected.length) return [];
  if (signal.aborted) throw new RequestError("会话读取已取消或超时。");
  const query = new URLSearchParams({ uids: selected.map(row => row.uid).join(",") });
  const cards = await get(IM, "/account/v1/user/cards?" + query, session, signal);
  if (!Array.isArray(cards)) invalid();
  const profiles = new Map();
  for (const card of cards) {
    if (!card || !count(card.mid) || !card.mid || typeof card.name !== "string") invalid();
    profiles.set(card.mid, card);
  }
  return selected.map(row => {
    const profile = profiles.get(row.uid);
    return { ...row, name: profile?.name.trim() || "UID " + row.uid, avatar: imageURL(profile?.face) };
  });
}
async function loadPrivate(session, version, signal) {
  const uid = account.uid;
  const jobs = [["private", () => get(IM, "/session_svr/v1/session_svr/single_unread?unread_type=0&show_unfollow_list=1&show_dustbin=1&build=0&mobi_app=web", session, signal),
    data => { privateMessages = readPrivate(data); }]];
  if (privateDisplay === "list") jobs.push(["conversations", () => loadConversations(uid, session, signal), data => { conversations = data; }]);
  await Promise.all(jobs.map(async ([key, request, apply]) => {
    try {
      const value = await request();
      if (version !== generation || !privateEnabled()) return;
      apply(value);
      times[key] = Date.now();
      delete errors[key];
    } catch (error) { if (version === generation && privateEnabled()) errors[key] = safeError(error); }
  }));
