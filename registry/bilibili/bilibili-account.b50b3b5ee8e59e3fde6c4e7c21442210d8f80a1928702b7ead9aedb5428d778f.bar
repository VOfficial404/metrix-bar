  const tasks = [];
  if (features.followers) tasks.push(
    ["followers", () => get(API, "/x/relation/stat?vmid=" + next.uid, session, signal), data => { followers = readFollowers(next.uid, data); }],
    ["followerDaily", () => get(MEMBER, "/x/web/data/v2/fans/stat/num?period=-1", session, signal), data => { followerDaily = readFollowerDaily(data); }],
    ["followerTrend", () => loadFollowerTrend(session, signal), data => { followerTrend = data; }]);
  if (notificationsEnabled()) tasks.push(
    ["notifications", () => get(IM, "/x/im/web/msgfeed/unread?build=0&mobi_app=web", session, signal), data => { notifications = readNotifications(data); }]);
  const results = await Promise.allSettled(tasks.map(async ([key, request, apply]) => {
    const data = await request();
    if (version !== generation) return;
    apply(data);
    times[key] = Date.now();
    delete errors[key];
  }));
  await privateRefresh;
  if (version !== generation) return;
  results.forEach((result, i) => {
    if (result.status === "rejected") errors[tasks[i][0]] = safeError(result.reason);
