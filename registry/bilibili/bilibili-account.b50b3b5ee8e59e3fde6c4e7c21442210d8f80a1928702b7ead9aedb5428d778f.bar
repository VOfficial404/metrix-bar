  if (version !== generation) return;
  if (account && account.uid !== next.uid) {
    followers = followerDaily = followerTrend = null;
    for (const key of ["followers", "followerDaily", "followerTrend"]) { delete times[key]; delete errors[key]; }
  }
  account = next;
  times.account = Date.now();
  delete errors.account;
