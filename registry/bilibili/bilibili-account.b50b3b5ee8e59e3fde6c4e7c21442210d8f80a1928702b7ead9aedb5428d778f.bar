const h = (type, props = {}, ...children) => ({ type, props, children: children.flat().filter(v => v != null && v !== false) });
const text = (value, props = {}) => h("Text", { text: String(value), ...props });
const count = value => Number.isSafeInteger(value) && value >= 0;
const metric = value => typeof value === "number" && Number.isFinite(value) && value >= 0;
const comma = value => value == null ? "—" : String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
const signed = value => (value > 0 ? "+" : "") + comma(value);
const stamp = time => {
  if (!time) return "尚未更新";
  const d = new Date(time);
  return `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
};
const launch = url => () => $metrix.openURL(url);
let credential = "", inputError = "", videoLimit = 5, initialized = false, generation = 0;
let account = null, followers = null, videos = null, privateMessages = null, notifications = null;
let followerDaily = null;
let followerTrend = null, followerChart = { days: 7, metric: "net" }, followerChartError = "";
const FOLLOWER_METRICS = [
  { value: "follow", label: "新增关注", color: "success" },
  { value: "unfollow", label: "取关", color: "danger" },
  { value: "net", label: "净增", color: "accent" },
];
const ACCOUNT_SIZES = {
  compact: { compact: true, padding: 8, gap: 4, value: 14, identityHeight: 28 },
  normal: { compact: false, padding: 12, gap: 8, value: 16, identityHeight: 34 },
  large: { compact: false, padding: 16, gap: 12, value: 18, identityHeight: 42 },
};
const accountSizes = { identity: ACCOUNT_SIZES.compact, followers: ACCOUNT_SIZES.compact,
  daily: ACCOUNT_SIZES.compact, level: ACCOUNT_SIZES.compact };
let followerChartHeight = 100, accountPanelHeight = 560;
let privateDisplay = "summary", privateLimit = 5, privateCardSize = "normal", conversations = null;
let times = {}, errors = {}, loading = false, inflight = null, inflightGeneration = -1, refreshController = null;
let tab = "messages";
// --stage-* maps to native background/text/textMuted/border/surface/accent/accentText.
const TABS = [{ id: "messages", label: "消息" }, { id: "dynamic", label: "动态" }, { id: "videos", label: "视频" }, { id: "account", label: "账户" }];
let menuRanks = TABS.map((_, index) => (index + 1) * 10);
function updateTabs(initial = false) {
  tabs = TABS.slice().sort((a, b) => menuRanks[TABS.indexOf(a)] - menuRanks[TABS.indexOf(b)])
    .filter(item => item.id === "account" ? features.identity || features.followers || features.level
      : item.id === "messages" ? messagesEnabled() : features[item.id]);
  if (!tabs.length) tabs = [TABS.find(item => item.id === "account")];
  if (initial || !tabs.some(item => item.id === tab)) tab = tabs[0].id;
  stopMotion();
}
const VIDEO_STATS = [
  { option: "video_views", label: "播放", field: "views", api: "view" },
  { option: "video_likes", label: "点赞", field: "likes", api: "like" },
  { option: "video_favorites", label: "收藏", field: "favorites", api: "favorite" },
  { option: "video_coins", label: "投币", field: "coins", api: "coin" },
  { option: "video_comments", label: "评论", field: "replies", api: "reply" },
];
const NOTIFICATION_FEATURE_KEYS = ["message_likes", "message_replies", "message_mentions", "message_system", "message_assistant"];
const FEATURE_KEYS = ["account", "identity", "followers", "level", "videos", "messages", "dynamic", "video_cover", "video_date",
  ...VIDEO_STATS.map(stat => stat.option), "message_private", ...NOTIFICATION_FEATURE_KEYS];
let features = Object.fromEntries(FEATURE_KEYS.map(key => [key, true])), tabs = TABS;
let dynamics = null, dynamicController = null, dynamicInflight = null;
let dynamicFilterUID = null, dynamicFilter = { mode: "all", uids: [] };
let dynamicFilterOpen = false, dynamicSearch = "", dynamicUIDDraft = "", dynamicFilterError = "";
const validUID = value => typeof value === "string" && /^[1-9]\d{0,15}$/.test(value) && Number.isSafeInteger(Number(value));
function restoreDynamicFilter(uid) {
  if (dynamicFilterUID === uid) return;
  cancelDynamicRefresh();
  dynamics = null;
  delete times.dynamic;
  delete errors.dynamic;
  let saved;
  try { saved = JSON.parse(localStorage.getItem("dynamic-filter:v1:" + uid) || "null"); } catch {}
  dynamicFilterUID = uid;
  dynamicFilter = { mode: ["all", "include", "exclude"].includes(saved?.mode) ? saved.mode : "all",
    uids: Array.isArray(saved?.uids) ? [...new Set(saved.uids.filter(validUID))].slice(0, 100) : [] };
  dynamicSearch = dynamicUIDDraft = dynamicFilterError = "";
  dynamicFilterOpen = false;
}
function saveDynamicFilter(next) {
  if (!account || dynamicFilterUID !== account.uid) return;
  if (!["all", "include", "exclude"].includes(next.mode) || !next.uids.every(validUID)) return;
  if (next.uids.length > 100) { dynamicFilterError = "最多选择 100 位用户。"; $metrix.invalidate(); return; }
  try { localStorage.setItem("dynamic-filter:v1:" + account.uid, JSON.stringify(next)); }
  catch { dynamicFilterError = "用户筛选保存失败，请重试。"; $metrix.invalidate(); return; }
  dynamicFilter = next;
  dynamicFilterError = "";
  $metrix.invalidate();
}
function selectDynamicUser(uid, selected) {
  saveDynamicFilter({ ...dynamicFilter, uids: selected ? [...new Set([...dynamicFilter.uids, uid])]
    : dynamicFilter.uids.filter(value => value !== uid) });
}
function addDynamicUser() {
  const uid = dynamicUIDDraft.trim();
  if (!validUID(uid)) { dynamicFilterError = "请输入有效的数字 UID。"; $metrix.invalidate(); return; }
  selectDynamicUser(uid, true);
  if (!dynamicFilterError) dynamicUIDDraft = "";
}
const privateEnabled = () => features.messages && features.message_private;
const notificationsEnabled = () => features.messages && NOTIFICATION_FEATURE_KEYS.some(key => features[key]);
const messagesEnabled = () => privateEnabled() || notificationsEnabled();
function hasUnreadMessages() {
  if (!features.messages) return false;
  const n = notifications;
  return (privateEnabled() && privateMessages?.total > 0)
    || (features.message_likes && n?.likes > 0)
    || (features.message_replies && n?.reply > 0)
    || (features.message_mentions && n?.at > 0)
    || (features.message_system && n?.system > 0)
    || (features.message_assistant && n?.assistant > 0)
    || (features.message_replies && features.message_mentions && n?.reply === null && n?.at === null && n?.combined > 0);
}
function UnreadDot(key) {
  return h("Box", { key, width: 5, height: 5, radius: 2.5, background: "#E5484D", shrink: 0, translate: [0, -5],
    label: "有未读消息", tooltip: "有未读消息" });
}
const PRIVATE_RATES = {
  "5m": { ms: 300000, label: "5 分钟" }, "10m": { ms: 600000, label: "10 分钟" },
  "30m": { ms: 1800000, label: "30 分钟" }, "1h": { ms: 3600000, label: "1 小时" },
  "6h": { ms: 21600000, label: "6 小时" },
};
let globalRefreshMinutes = null;
const globalRefreshLabel = () => globalRefreshMinutes % 60 === 0 ? globalRefreshMinutes / 60 + " 小时" : globalRefreshMinutes + " 分钟";
let privateRate = "10m", privateLive = false, privateTimer = null, privateInflight = null;
let privateController = null, privateAttemptAt = 0;
