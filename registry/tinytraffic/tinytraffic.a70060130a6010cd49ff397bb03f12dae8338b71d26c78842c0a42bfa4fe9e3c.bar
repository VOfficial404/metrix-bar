      h("Select", { key: "site", label: "选择站点", value: selected, basis: 140, grow: 1, minWidth: 120, items: sites.map(s => ({ value: s.id, label: s.domain })), onChange: selectSite }),
      h("Select", { key: "period", label: "时间范围", value: period, items: items(PERIODS), onChange: selectPeriod, basis: 104, minWidth: 104, grow: 1 })) : null);
}
function MetricGrid() {
  return h("Row", { key: "metric-grid", wrap: true, gap: 4, width: "100%", minWidth: 0 }, METRICS.map(([key, label]) => {
    const d = stats ? change(key, stats.current[key], stats.previous?.[key]) : null;
