      return h("ButtonBase", { key: "rank-" + i, label: "筛选 " + emptyLabel(dimension, row.value), onClick: () => addFilter(row.value), padding: [3, 4], width: "100%", minWidth: 0, radius: 5, focusRing: true, hover: { background: "surfaceHover" }, tooltip: emptyLabel(dimension, row.value) + "\n访客 " + full(row.visitors) + " · " + (dimension === "event" ? "完成次数 " : ["entry_page", "exit_page"].includes(dimension) ? "访问次数 " : "浏览量 ") + full(row.count) },
        h("Column", { gap: 3, width: "100%", minWidth: 0 },
          h("Row", { gap: 8, width: "100%", minWidth: 0, alignItems: "center" }, txt(emptyLabel(dimension, row.value), { key: "rank-label-" + i, fontSize: 12, grow: 1, minWidth: 0, singleLine: true }),
            txt(full(row.visitors), { fontSize: 12, fontFeatures: "tnum", shrink: 0 }), muted(share.toFixed(1) + "%", { width: 46, textAlign: "end", fontFeatures: "tnum", shrink: 0 })),
          h("Box", { width: "100%", height: 2, background: "surfaceHover", radius: 1 }, h("Box", { width: share + "%", height: 2, background: INK, radius: 1 }))));
    }) : muted(busy ? "正在读取排行…" : ranking ? "没有匹配的访问记录" : "排行尚不可用", { key: "ranking-empty", paddingY: 14, wrap: true }),
    ranking ? muted("点击条目筛选全部统计", { tooltip: "分母是同一范围及筛选条件下的访客数；同一访客可属于多行，占比合计可能超过 100%。排行更新：" + stamp(rankAt) }) : null);
}
function Body() {
  if (setupError || !config.key) return h("Scroll", { key: "setup-scroll", grow: 1, minHeight: 0, width: "100%" },
    h("Column", { padding: 15, gap: 10, width: "100%", minWidth: 0 },
      txt("连接你的流量数据", { key: "setup", fontSize: 18, fontWeight: 600, wrap: true }),
      muted(setupError || "在看板设置中填写 tinytraffic 服务地址和只读 API Key。", { wrap: true, fontSize: 12 }),
      muted("在 tinytraffic 的 Account → API keys 创建 Read only 密钥。连接后即可切换站点、查看趋势与筛选访客来源。", { wrap: true, fontSize: 12 }),
      config.base ? consoleButton("setup-open", { alignSelf: "start", border: [1, "border"] }) : null));
  return h("Scroll", { key: "content-scroll", grow: 1, minHeight: 0, width: "100%" },
    h("Column", { gap: 8, width: "100%", minWidth: 0, padding: [4, 15, 12, 15] },
      ErrorNotice("sites"), ErrorNotice("preferences"),
      sites === null ? muted(busy ? "正在连接并读取站点…" : "尚未连接，请点击刷新。", { key: "sites-pending", paddingY: 24, wrap: true })
      : !sites.length ? h("Column", { gap: 8, width: "100%" }, txt("还没有站点", { key: "no-sites", fontSize: 20, fontWeight: 600 }), muted("在 tinytraffic 中添加站点和追踪脚本，然后刷新。", { wrap: true }), consoleButton("add-site-web", { alignSelf: "start" }))
      : h("Column", { gap: 8, width: "100%", minWidth: 0 },
        period === "custom" ? h("Column", { gap: 6, width: "100%" },
          h("Row", { gap: 6, width: "100%", wrap: true },
            h("TextInput", { key: "date-from", label: "开始日期", placeholder: "YYYY-MM-DD", value: draftFrom, basis: 104, grow: 1, minWidth: 104, onChange: value => { draftFrom = String(value); } }),
            h("TextInput", { key: "date-to", label: "结束日期", placeholder: "YYYY-MM-DD", value: draftTo, basis: 104, grow: 1, minWidth: 104, onChange: value => { draftTo = String(value); } }),
            button("apply-dates", "应用", applyDates, { shrink: 0 })), ErrorNotice("dates")) : null,
        filters.length ? h("Column", { key: "filters", gap: 4, width: "100%" },
          filters.map((f, i) => button("filter-" + i, DIMS.find(d => d[0] === f.dim)[1] + "：" + emptyLabel(f.dim, f.value) + "  ×", () => removeFilter(i), { width: "100%", minWidth: 0, tooltip: "移除此筛选：" + f.value, background: "surfaceHover" })),
          button("clear-filters", "清除筛选", resetFilters, { alignSelf: "start" })) : null,
        ErrorNotice("filters"), ErrorNotice("stats"), MetricGrid(), Trend(),
        h("Divider"), Ranking(), ErrorNotice("realtime"))));
}
function view() {
  const site = currentSite(), problem = setupError || Object.values(errors).join(" ");
  return {
    tray: { icon: "data:image/svg+xml," + encodeURIComponent(MARK), iconTemplate: true,
      title: stats ? format("visitors", stats.current.visitors) : "", error: problem,
      tooltip: site ? site.domain + " · " + (stats ? format("visitors", stats.current.visitors) + " 访客 · " + stats.query.from + " 至 " + stats.query.to : "统计尚不可用") + (filters.length ? " · 已筛选" : "") + (realtime == null ? "" : " · 近5分钟 " + realtime) : "tinytraffic · 网站流量观察",
      menu: [{ label: "刷新", onClick: () => load(), disabled: busy || !config.key || !!setupError }, { label: "打开控制台", onClick: openDashboard, disabled: !config.base }] },
    panel: h("Column", { preferredWidth: 340, preferredHeight: !config.key || setupError ? 280 : 560, width: "100%", height: "100%", minWidth: 0, minHeight: 0, safeArea: true, background: "surface", textColor: "text", fontSize: 12,
      shortcuts: { "CmdOrCtrl+R": () => load() } }, Header(), Body(), h("Divider"),
      h("Row", { padding: [8, 15], gap: 6, width: "100%", alignItems: "center", shrink: 0 },
        muted(busy ? "正在更新…" : loadedAt ? "更新 " + stamp(loadedAt) + (Object.keys(errors).length ? " · 部分数据未更新" : "") : "等待连接", { key: "refresh-status", grow: 1, minWidth: 0, singleLine: true }),
        muted(refreshMinutes % 60 === 0 ? "每 " + refreshMinutes / 60 + " 小时" : "每 " + refreshMinutes + " 分钟", { key: "refresh-frequency", shrink: 0, tooltip: "自动刷新间隔，可在看板设置中修改。活跃数与统计一起更新。" }), button("refresh", "刷新", () => load(), { disabled: busy || !config.key || !!setupError })))
  };
}
export default {
  async scheduled(env) { sync(env); await load(); },
  render(env) { sync(env); return view(); },
  event(name, payload) {
    if (name === "lifecycle" && payload?.type === "start" && !workerLive) {
      $metrix.schedule(refreshMinutes * 60000);
      workerLive = true;
    }
    if (name === "lifecycle" && payload?.type === "stop") { workerLive = false; cancel(); }
  },
};
  ]]></script>
</bar>
