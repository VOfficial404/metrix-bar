      h("Select", { key: "dimension", label: "排行维度", value: dimension, items: items(DIMS), onChange: selectDimension, grow: 1, minWidth: 0 }), muted("访客 / 占比", { shrink: 0 })),
    ErrorNotice("ranking"),
    ranking?.rows.length ? ranking.rows.map((row, i) => {
