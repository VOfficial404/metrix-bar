        muted(d?.text || "—", { key: "delta-" + key, textColor: d?.color || "textMuted", fontFeatures: "tnum", tooltip: "较前一等长时段；前期为零时不计算百分比。", singleLine: true }),
        h("Box", { width: "100%", height: 2, marginTop: 2, background: key === metric ? INK : "surface", radius: 1 })));
  }));
}
function Trend() {
  const name = METRICS.find(m => m[0] === metric)[1], points = stats?.points;
  return h("Column", { gap: 6, width: "100%", minWidth: 0 },
    h("Row", { alignItems: "center", gap: 6, width: "100%" }, h("Box", { width: 12, height: 2, background: INK }), txt(name + "趋势", { fontSize: 12, fontWeight: 500, grow: 1 }), muted("按站点时区")),
    points?.length ? h("Chart", { key: "traffic-chart", type: "area", height: 100, width: "100%", minWidth: 0, xKind: "category", labels: points.map(p => stats.query.interval === "hour" ? p.date.slice(5, 10) + " " + p.date.slice(11, 16) : stats.query.interval === "month" ? p.date.slice(0, 7) : p.date.slice(5, 10)),
      curve: "linear", strokeWidth: 2, xTicks: 3, yTicks: 3, gridStyle: "dashed", hover: true, appear: false, dots: points.length === 1,
      yDomain: [0, Math.max(metric === "bounce_rate" ? 100 : 1, ...points.map(p => p[metric]))],
      series: [{ name, color: INK, fill: 0.08, points: points.map((p, i) => ({ x: i, y: p[metric], label: p.date.replace("T", " ") + " " + stats.query.timezone, valueLabel: format(metric, p[metric]) })) }], label: name + "，站点时区 " + stats.query.timezone })
      : muted(busy ? "正在读取趋势…" : stats ? "此时段没有时间桶" : "趋势尚不可用", { key: "trend-empty", height: 80, width: "100%", textAlign: "center" }),
    stats ? muted(stats.query.from + " — " + stats.query.to + "  " + stats.query.timezone, { key: "range-caption", wrap: true, tooltip: "访客标识每天轮换；跨日访客数不是整个时段去重人数。" }) : null);
}
function Ranking() {
