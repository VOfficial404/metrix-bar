        api(path + "/realtime", connection, c.signal).then(raw => { if (!integer(raw?.visitors)) throw new Error("实时访客响应无效。"); return raw.visitors; }),
        dim === "event" ? rankRequest : api(path + "/breakdown/event?" + qs + "&limit=" + connection.limit, connection, c.signal).then(breakdown),
      ]);
