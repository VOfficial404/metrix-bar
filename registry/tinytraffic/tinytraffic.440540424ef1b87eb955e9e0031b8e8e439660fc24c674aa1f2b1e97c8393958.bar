        const raw = await api("/sites", connection, c.signal);
        if (!Array.isArray(raw) || raw.some(s => !s || !integer(s.id) || !s.id || typeof s.domain !== "string" || !s.domain || typeof s.timezone !== "string") || new Set(raw.map(s => s.id)).size !== raw.length) throw new Error("站点列表响应无效。");
        if (g !== generation) return;
        sites = raw.map(s => ({ id: String(s.id), domain: s.domain, timezone: s.timezone }));
        if (!currentSite()) { selected = sites[0]?.id || ""; stats = ranking = realtime = goals = null; loadedAt = liveAt = rankAt = goalsAt = 0; filters = []; q.filters = []; persist(); }
      }
      if (!selected || g !== generation) return;
      const path = "/sites/" + encodeURIComponent(selected), qs = queryString(q);
      const rankRequest = api(path + "/breakdown/" + dim + "?" + qs + "&limit=" + connection.limit, connection, c.signal).then(breakdown);
      const result = await Promise.allSettled([
        Promise.all([api(path + "/aggregate?" + qs, connection, c.signal), api(path + "/timeseries?" + qs, connection, c.signal)]).then(([a, t]) => {
          const meta = queryMeta(a.query, q), tm = queryMeta(t.query, q);
          if (meta.from !== tm.from || meta.to !== tm.to || meta.interval !== tm.interval || meta.timezone !== tm.timezone) throw new Error("汇总与趋势的统计范围不一致，请刷新。");
