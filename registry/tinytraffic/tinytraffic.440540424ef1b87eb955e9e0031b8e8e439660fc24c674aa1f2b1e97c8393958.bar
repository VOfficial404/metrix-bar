  if (inflight) return inflight;
  if (period === "custom" && (!validDate(from) || !validDate(to) || from > to)) return Promise.resolve();
  const c = controller = new AbortController(), g = ++generation, connection = config;
  const q = { period, from, to, filters: filters.map(f => ({ ...f })) }, dim = dimension;
  const timeout = setTimeout(() => c.abort(), 12000);
  busy = true; delete errors.sites; $metrix.invalidate();
  inflight = (async () => {
    try {
