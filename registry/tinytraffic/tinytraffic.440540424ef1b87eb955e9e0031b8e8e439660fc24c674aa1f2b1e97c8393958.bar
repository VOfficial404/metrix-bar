}
async function api(path, connection, signal) {
  let res;
  try { res = await fetch(connection.base + "/api/v1" + path, { signal, redirect: "error", headers: { Accept: "application/json", Authorization: "Bearer " + connection.key } }); }
  catch { throw new Error(signal.aborted ? "请求已取消或超时。" : "无法连接 tinytraffic，请检查服务地址与网络。"); }
  if (!res.ok) {
    await res.body?.cancel();
    throw new Error(({ 401: "API Key 无效或已撤销，请在设置中更换。", 403: "API Key 没有读取权限。", 404: "站点或 API 不存在，请检查 tinytraffic 版本。", 429: "请求频率受限，请稍后刷新。" })[res.status] || "服务返回 HTTP " + res.status + "。");
  }
