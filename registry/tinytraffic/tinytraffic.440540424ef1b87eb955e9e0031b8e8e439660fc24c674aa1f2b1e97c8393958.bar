function resetFilters() { clearQuery(); filters = []; revealRegion("content"); return load(false); }
const openDashboard = () => { if (config?.base) $metrix.openURL(config.base + (selected ? "/sites/" + encodeURIComponent(selected) : "/")); };
const button = (key, label, action, props = {}) => h("ButtonBase", { key, label, onClick: action, focusRing: true, radius: 6, paddingX: 8, height: 28, hover: { background: "surfaceHover" }, pressed: { background: "surfacePressed" }, ...props }, txt(label, { fontSize: 12, singleLine: true, minWidth: 0, shrink: 1 }));
function consoleButton(key, props = {}) {
  return h("ButtonBase", { key, label: "打开控制台", tooltip: "在浏览器中打开" + (currentSite() ? "当前站点控制台：" + currentSite().domain : " tinytraffic 控制台"), onClick: openDashboard, focusRing: true, height: 28, paddingX: 6, radius: 5, shrink: 0, hover: { background: "surfaceHover" }, ...props },
    h("Row", { gap: 4, alignItems: "center" }, txt("控制台", { fontSize: 12, singleLine: true }),
      h("Icon", { width: 13, height: 13, svg: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7M21 3l-11 11M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/></svg>' })));
}
const stamp = time => time ? new Date(time).toLocaleString([], { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false }) : "尚未更新";
const emptyLabel = (dim, value) => value || (["source", "referrer", "referrer_url"].includes(dim) ? "直接访问" : "未知 / 未设置");
function ErrorNotice(key) {
  return errors[key] ? muted(errors[key], { key: "error-" + key, textColor: "warning", wrap: true, width: "100%" }) : null;
}
function Header() {
  return h("Column", { gap: 8, width: "100%", padding: [8, 12], shrink: 0 },
