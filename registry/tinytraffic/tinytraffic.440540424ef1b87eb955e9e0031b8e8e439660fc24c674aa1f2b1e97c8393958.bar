      h("Select", { key: "period", label: "时间范围", value: period, items: items(PERIODS), onChange: selectPeriod, basis: 112, minWidth: 104, grow: 1 })) : null);
}
function comparisonLabel() {
  const range = stats?.query.period || period;
  return ({ "24h": "较前 24 小时", "7d": "较前 7 天", "30d": "较前 30 天", "90d": "较前 90 天", "12mo": "较前 12 个月" })[range] || "较前一时段";
}
function MetricGrid() {
